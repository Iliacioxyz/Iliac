# Contact form delivery. Without these the form refuses gracefully and points
# people at the direct address instead of pretending to send.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Sender. Must be on a domain verified in Resend, not a free mailbox.
CONTACT_FROM="ILIAC Website <website@iliac.xyz>"

# Where enquiries land. Defaults to site.email if unset.
CONTACT_TO=business@iliac.xyz
