# Contact form delivery. Without RESEND_API_KEY the form refuses gracefully
# rather than pretending to send. Put real values in .env.local, never here.

# https://resend.com/api-keys — starts with re_
RESEND_API_KEY=

# Where enquiries land.
CONTACT_TO=iliac.io.xyz@gmail.com

# Sender. Optional: defaults to Resend's shared onboarding@resend.dev, which
# needs no DNS but only delivers to the Resend account owner's own address.
# For production, verify a domain in Resend and use an address on it. A Gmail
# or other free mailbox cannot be the sender.
# CONTACT_FROM="ILIAC Website <website@iliac.xyz>"
